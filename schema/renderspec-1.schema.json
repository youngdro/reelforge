{
  "$defs": {
    "Animated": {
      "anyOf": [
        {
          "description": "The same value throughout.",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        {
          "description": "Keyframes, sorted by time; before the first and after the last the value holds.",
          "items": {
            "$ref": "#/$defs/Key"
          },
          "type": "array"
        }
      ],
      "description": "A value that is either constant or keyframed."
    },
    "Animated2": {
      "anyOf": [
        {
          "description": "The same value throughout.",
          "format": "float",
          "type": "number"
        },
        {
          "description": "Keyframes, sorted by time; before the first and after the last the value holds.",
          "items": {
            "$ref": "#/$defs/Key2"
          },
          "type": "array"
        }
      ],
      "description": "A value that is either constant or keyframed."
    },
    "Asset": {
      "additionalProperties": false,
      "description": "A file the edit reads, addressed by content.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/AssetKind",
          "description": "What the file is."
        },
        "of": {
          "description": "For a derived asset (a mask sequence, a stabilisation track), the asset it was made from.",
          "type": [
            "string",
            "null"
          ]
        },
        "probe": {
          "anyOf": [
            {
              "$ref": "#/$defs/Probe"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the editor measured when it imported the file."
        },
        "sha256": {
          "description": "SHA-256 of the file's bytes, lowercase hex. This, not the URI, is the asset's identity.",
          "type": "string"
        },
        "uri": {
          "description": "Where to fetch it: `file:`, `https:`, `s3:`, `opfs:`… A renderer may resolve the hash\nthrough its own cache instead.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "sha256",
        "uri"
      ],
      "type": "object"
    },
    "AssetKind": {
      "description": "Asset kinds.",
      "oneOf": [
        {
          "const": "video",
          "description": "Video, possibly with sound.",
          "type": "string"
        },
        {
          "const": "image",
          "description": "A still image.",
          "type": "string"
        },
        {
          "const": "audio",
          "description": "Sound only.",
          "type": "string"
        },
        {
          "const": "font",
          "description": "A font file.",
          "type": "string"
        },
        {
          "const": "mask_sequence",
          "description": "Per-frame alpha masks derived from another asset.",
          "type": "string"
        },
        {
          "const": "lut",
          "description": "A colour lookup table.",
          "type": "string"
        }
      ]
    },
    "AudioClip": {
      "additionalProperties": false,
      "description": "Sound from an asset.",
      "properties": {
        "asset": {
          "description": "A `video` or `audio` asset.",
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/Tick",
          "description": "When it starts on the output timeline."
        },
        "dur": {
          "$ref": "#/$defs/Tick",
          "description": "How long it plays; positive."
        },
        "gain_db": {
          "$ref": "#/$defs/Animated2",
          "default": 0.0,
          "description": "Gain in dB; keyframe times are relative to the clip's start."
        },
        "id": {
          "description": "Id, unique among audio clips.",
          "type": "string"
        },
        "keep_pitch": {
          "description": "At a speed other than 1, stretch the sound in time keeping its pitch (feature\n`audio.stretch/1`) instead of resampling it, which moves the pitch with the speed.",
          "type": "boolean"
        },
        "time": {
          "$ref": "#/$defs/TimeMap",
          "default": {
            "source_in": 0,
            "speed": 1.0
          },
          "description": "Which source instant plays when."
        }
      },
      "required": [
        "id",
        "asset",
        "at",
        "dur"
      ],
      "type": "object"
    },
    "AudioCodec": {
      "description": "Audio codecs.",
      "oneOf": [
        {
          "const": "aac",
          "description": "AAC-LC.",
          "type": "string"
        },
        {
          "const": "opus",
          "description": "Opus.",
          "type": "string"
        }
      ]
    },
    "AudioEncoding": {
      "additionalProperties": false,
      "description": "Audio encoding settings.",
      "properties": {
        "bitrate_kbps": {
          "description": "Bitrate in kbit/s.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "codec": {
          "$ref": "#/$defs/AudioCodec",
          "description": "Codec."
        },
        "sample_rate": {
          "description": "Sample rate in Hz.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "codec",
        "sample_rate",
        "bitrate_kbps"
      ],
      "type": "object"
    },
    "Blend": {
      "description": "Blend modes.",
      "oneOf": [
        {
          "const": "normal",
          "description": "Over.",
          "type": "string"
        },
        {
          "const": "add",
          "description": "Sum.",
          "type": "string"
        },
        {
          "const": "multiply",
          "description": "Product.",
          "type": "string"
        },
        {
          "const": "screen",
          "description": "Inverse product.",
          "type": "string"
        },
        {
          "const": "overlay",
          "description": "Multiply in the dark parts, screen in the bright (feature `blend/2`, as are those below).",
          "type": "string"
        },
        {
          "const": "darken",
          "description": "The darker of the two.",
          "type": "string"
        },
        {
          "const": "lighten",
          "description": "The lighter of the two.",
          "type": "string"
        },
        {
          "const": "soft_light",
          "description": "A gentle overlay.",
          "type": "string"
        },
        {
          "const": "hard_light",
          "description": "Overlay, led by the layer.",
          "type": "string"
        },
        {
          "const": "difference",
          "description": "The difference.",
          "type": "string"
        },
        {
          "const": "color_dodge",
          "description": "Brightens what is below.",
          "type": "string"
        },
        {
          "const": "color_burn",
          "description": "Darkens what is below.",
          "type": "string"
        }
      ]
    },
    "Color": {
      "description": "A straight (not premultiplied) sRGB colour with alpha, each 0 to 1.",
      "items": {
        "format": "float",
        "type": "number"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "Crop": {
      "additionalProperties": false,
      "description": "Edges cut off a picture, as fractions of its width (`left`, `right`) and height (`top`,\n`bottom`); what is left must be at least 1 % of each.",
      "properties": {
        "bottom": {
          "default": 0.0,
          "description": "From the bottom edge.",
          "format": "float",
          "type": "number"
        },
        "left": {
          "default": 0.0,
          "description": "From the left edge.",
          "format": "float",
          "type": "number"
        },
        "right": {
          "default": 0.0,
          "description": "From the right edge.",
          "format": "float",
          "type": "number"
        },
        "top": {
          "default": 0.0,
          "description": "From the top edge.",
          "format": "float",
          "type": "number"
        }
      },
      "type": "object"
    },
    "Ease": {
      "description": "Interpolation from one key to the next.",
      "oneOf": [
        {
          "const": "linear",
          "description": "Straight line.",
          "type": "string"
        },
        {
          "const": "hold",
          "description": "Hold this value until the next key.",
          "type": "string"
        },
        {
          "const": "in_out",
          "description": "Smoothstep: slow out of this key and into the next.",
          "type": "string"
        }
      ]
    },
    "Effect": {
      "additionalProperties": false,
      "description": "An effect applied to a layer.",
      "properties": {
        "asset": {
          "description": "An asset the effect reads: the `lut` of `color.lut@1`.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "`<name>@<version>`, such as `color.brightness@1`.",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/Animated2"
          },
          "default": {},
          "description": "Parameters by name.",
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "EngineRequirements": {
      "additionalProperties": false,
      "description": "What a renderer must provide to draw this spec.",
      "properties": {
        "features": {
          "description": "Feature ids the spec uses beyond the base format, such as `text/1`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "min": {
          "description": "The oldest renderer version that draws this spec correctly (semver), if any.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Fit": {
      "description": "How media is fitted to the output frame.",
      "oneOf": [
        {
          "const": "contain",
          "description": "Whole picture visible, bars where the shapes differ.",
          "type": "string"
        },
        {
          "const": "cover",
          "description": "Frame covered, picture cropped where the shapes differ.",
          "type": "string"
        },
        {
          "const": "stretch",
          "description": "Stretched to the frame.",
          "type": "string"
        }
      ]
    },
    "FrameRate": {
      "description": "A rational frame rate, `num / den` frames per second (30000 / 1001 is 29.97).",
      "properties": {
        "den": {
          "description": "Denominator; never zero.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "num": {
          "description": "Numerator.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "num",
        "den"
      ],
      "type": "object"
    },
    "Key": {
      "additionalProperties": false,
      "description": "One keyframe.",
      "properties": {
        "ease": {
          "$ref": "#/$defs/Ease",
          "default": "linear",
          "description": "How the value moves from this key to the next."
        },
        "t": {
          "$ref": "#/$defs/Tick",
          "description": "Time relative to the owner's start."
        },
        "v": {
          "description": "Value at that time.",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "t",
        "v"
      ],
      "type": "object"
    },
    "Key2": {
      "additionalProperties": false,
      "description": "One keyframe.",
      "properties": {
        "ease": {
          "$ref": "#/$defs/Ease",
          "default": "linear",
          "description": "How the value moves from this key to the next."
        },
        "t": {
          "$ref": "#/$defs/Tick",
          "description": "Time relative to the owner's start."
        },
        "v": {
          "description": "Value at that time.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "t",
        "v"
      ],
      "type": "object"
    },
    "Layer": {
      "additionalProperties": false,
      "description": "One picture layer.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Tick",
          "description": "When the layer starts on the output timeline."
        },
        "blend": {
          "$ref": "#/$defs/Blend",
          "default": "normal",
          "description": "How it combines with what is below."
        },
        "content": {
          "$ref": "#/$defs/LayerContent",
          "description": "What it shows."
        },
        "crop": {
          "anyOf": [
            {
              "$ref": "#/$defs/Crop"
            },
            {
              "type": "null"
            }
          ],
          "description": "Edges cut off a media layer's picture before it is fitted (feature `crop/1`)."
        },
        "dur": {
          "$ref": "#/$defs/Tick",
          "description": "How long it lasts; positive."
        },
        "flip_x": {
          "description": "A media layer's picture mirrored left to right (feature `flip/1`).",
          "type": "boolean"
        },
        "flip_y": {
          "description": "A media layer's picture mirrored top to bottom (feature `flip/1`).",
          "type": "boolean"
        },
        "fx": {
          "description": "Effects, applied in order to the layer's own picture before it is placed.",
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "type": "array"
        },
        "id": {
          "description": "Id, unique in the spec; the editor uses its clip id so a render maps back to the edit.",
          "type": "string"
        },
        "mask": {
          "description": "A `mask_sequence` asset whose alpha multiplies this layer.",
          "type": [
            "string",
            "null"
          ]
        },
        "opacity": {
          "$ref": "#/$defs/Animated2",
          "default": 1.0,
          "description": "Opacity, 0 to 1."
        },
        "shape_mask": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShapeMask"
            },
            {
              "type": "null"
            }
          ],
          "description": "A shape that shows part of the layer, in the layer's own picture (feature `mask.shape/1`)."
        },
        "transform": {
          "$ref": "#/$defs/Transform",
          "default": {
            "position": [
              0.0,
              0.0
            ],
            "rotation": 0.0,
            "scale": 1.0
          },
          "description": "Where it sits. Keyframe times are relative to the layer's start."
        }
      },
      "required": [
        "id",
        "at",
        "dur",
        "content"
      ],
      "type": "object"
    },
    "LayerContent": {
      "description": "What a layer shows.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Frames of a video or image asset.",
          "properties": {
            "asset": {
              "description": "The asset id.",
              "type": "string"
            },
            "fit": {
              "$ref": "#/$defs/Fit",
              "default": "contain",
              "description": "How the picture is fitted to the frame before the transform applies."
            },
            "time": {
              "$ref": "#/$defs/TimeMap",
              "default": {
                "source_in": 0,
                "speed": 1.0
              },
              "description": "Which source instant each output instant shows."
            },
            "type": {
              "const": "media",
              "type": "string"
            }
          },
          "required": [
            "type",
            "asset"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A flat colour filling the frame.",
          "properties": {
            "color": {
              "$ref": "#/$defs/Color",
              "description": "The colour."
            },
            "type": {
              "const": "solid",
              "type": "string"
            }
          },
          "required": [
            "type",
            "color"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Set text (feature `text/1`).",
          "properties": {
            "align": {
              "$ref": "#/$defs/TextAlign",
              "default": "center",
              "description": "Alignment of the lines within the block."
            },
            "background": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TextBackground"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A box behind the block."
            },
            "color": {
              "$ref": "#/$defs/Color",
              "description": "Fill colour."
            },
            "font": {
              "description": "A `font` asset; absent means the renderer's bundled default face (Noto Sans SC, which also\ncovers Latin). Characters the face lacks fall back to the other faces the renderer has.",
              "type": [
                "string",
                "null"
              ]
            },
            "gradient": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Color"
                },
                {
                  "type": "null"
                }
              ],
              "description": "With `text/2`: the fill fades from `color` at the block's top to this at its bottom."
            },
            "outer": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TextStroke"
                },
                {
                  "type": "null"
                }
              ],
              "description": "With `text/2`: a second outline, outside `stroke` (its width counts from `stroke`'s edge)."
            },
            "shadow": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TextShadow"
                },
                {
                  "type": "null"
                }
              ],
              "description": "With `text/2`: a soft shadow of the glyphs and their outlines, beneath them."
            },
            "size": {
              "description": "Size of the em in output pixels.",
              "format": "float",
              "type": "number"
            },
            "stroke": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TextStroke"
                },
                {
                  "type": "null"
                }
              ],
              "description": "An outline around the glyphs, drawn beneath the fill."
            },
            "text": {
              "description": "The words; `\\n` breaks a line.",
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            },
            "weight": {
              "default": 400,
              "description": "Weight, 100 (thin) to 900 (black); 400 is regular, 700 bold.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "width": {
              "description": "Wrap width in output pixels; absent, lines break only at `\\n`.",
              "format": "float",
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "text",
            "size",
            "color"
          ],
          "type": "object"
        }
      ]
    },
    "MaskShape": {
      "description": "Mask shapes.",
      "oneOf": [
        {
          "const": "linear",
          "description": "Everything above a line through the centre (turned by `rotation`).",
          "type": "string"
        },
        {
          "const": "mirror",
          "description": "A band through the centre.",
          "type": "string"
        },
        {
          "const": "circle",
          "description": "An ellipse.",
          "type": "string"
        },
        {
          "const": "rectangle",
          "description": "A rectangle.",
          "type": "string"
        }
      ]
    },
    "Output": {
      "additionalProperties": false,
      "description": "Output settings.",
      "properties": {
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioEncoding"
            },
            {
              "type": "null"
            }
          ],
          "description": "How to encode the sound; absent for a silent output."
        },
        "background": {
          "$ref": "#/$defs/Color",
          "default": [
            0.0,
            0.0,
            0.0,
            1.0
          ],
          "description": "Colour under every layer (straight sRGB, 0 to 1)."
        },
        "duration": {
          "$ref": "#/$defs/Tick",
          "description": "Length of the output."
        },
        "fps": {
          "$ref": "#/$defs/FrameRate",
          "description": "Frame rate."
        },
        "height": {
          "description": "Height in pixels; even, at most 8192.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "video": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoEncoding"
            },
            {
              "type": "null"
            }
          ],
          "description": "How to encode the picture; absent when only frames are wanted."
        },
        "width": {
          "description": "Width in pixels; even, at most 8192.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "fps",
        "duration"
      ],
      "type": "object"
    },
    "Probe": {
      "additionalProperties": false,
      "description": "Measured properties of an asset.",
      "properties": {
        "duration": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tick"
            },
            {
              "type": "null"
            }
          ],
          "description": "Length, for time-based media."
        },
        "height": {
          "description": "Picture height in pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "width": {
          "description": "Picture width in pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ShapeMask": {
      "additionalProperties": false,
      "description": "A shape that shows part of a layer.\n\nIt is placed in the layer's own picture (after any crop), so it moves, turns and scales with\nthe layer. Lengths are in units of the picture's shorter side, so a circle stays round.",
      "properties": {
        "center": {
          "default": [
            0.5,
            0.5
          ],
          "description": "Its centre, as fractions of the picture's width and height (0.5, 0.5 is the middle).",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "feather": {
          "default": 0.0,
          "description": "Width of the soft edge, 0 for a hard one.",
          "format": "float",
          "type": "number"
        },
        "invert": {
          "description": "Show the outside instead.",
          "type": "boolean"
        },
        "rotation": {
          "default": 0.0,
          "description": "Clockwise turn, degrees.",
          "format": "float",
          "type": "number"
        },
        "shape": {
          "$ref": "#/$defs/MaskShape",
          "description": "Which shape."
        },
        "size": {
          "default": [
            0.5,
            0.5
          ],
          "description": "Width and height (for `mirror`, the height is the band's thickness; `linear` ignores it).",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "shape"
      ],
      "type": "object"
    },
    "SpeedKey": {
      "additionalProperties": false,
      "description": "One point of a speed ramp.",
      "properties": {
        "speed": {
          "description": "Speed there, -100 to 100.",
          "format": "double",
          "type": "number"
        },
        "t": {
          "$ref": "#/$defs/Tick",
          "description": "Time from the owner's start."
        }
      },
      "required": [
        "t",
        "speed"
      ],
      "type": "object"
    },
    "TextAlign": {
      "description": "How lines line up within a text block.",
      "oneOf": [
        {
          "const": "left",
          "description": "Left edges line up.",
          "type": "string"
        },
        {
          "const": "center",
          "description": "Centred.",
          "type": "string"
        },
        {
          "const": "right",
          "description": "Right edges line up.",
          "type": "string"
        }
      ]
    },
    "TextBackground": {
      "additionalProperties": false,
      "description": "A box behind text.",
      "properties": {
        "color": {
          "$ref": "#/$defs/Color",
          "description": "Colour."
        },
        "padding": {
          "default": 0.25,
          "description": "Space between the text and the box edge, in ems.",
          "format": "float",
          "type": "number"
        },
        "radius": {
          "description": "With `text/2`: corner radius, in ems.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "color"
      ],
      "type": "object"
    },
    "TextShadow": {
      "additionalProperties": false,
      "description": "A shadow beneath text.",
      "properties": {
        "blur": {
          "default": 0.0,
          "description": "Softness: the blur's standard deviation, in ems.",
          "format": "float",
          "type": "number"
        },
        "color": {
          "$ref": "#/$defs/Color",
          "description": "Colour."
        },
        "offset": {
          "description": "Offset `[right, down]` in ems, on the frame (it does not turn with the text).",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "color",
        "offset"
      ],
      "type": "object"
    },
    "TextStroke": {
      "additionalProperties": false,
      "description": "An outline around text.",
      "properties": {
        "color": {
          "$ref": "#/$defs/Color",
          "description": "Colour."
        },
        "width": {
          "description": "Width outside the glyph edge, in output pixels.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "color",
        "width"
      ],
      "type": "object"
    },
    "Tick": {
      "description": "A position or a duration in ticks.",
      "format": "int64",
      "type": "integer"
    },
    "TimeMap": {
      "additionalProperties": false,
      "description": "Source time for a media layer or audio clip: `source = source_in + ∫ speed dt` from the owner's\nstart. With no `ramp` the speed is constant, so `source = source_in + (t - at) * speed`.",
      "properties": {
        "ramp": {
          "description": "A speed that changes over time (feature `time.ramp/1`): straight lines between keys, held\nbefore the first and after the last. Key times are from the owner's start.",
          "items": {
            "$ref": "#/$defs/SpeedKey"
          },
          "type": "array"
        },
        "source_in": {
          "$ref": "#/$defs/Tick",
          "default": 0,
          "description": "Source instant shown at the owner's start."
        },
        "speed": {
          "default": 1.0,
          "description": "Playback speed, -100 to 100. 0 holds `source_in` (a freeze frame, feature `time.hold/1`);\nbelow 0 plays backwards (feature `time.reverse/1`). Ignored when `ramp` is given.",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "Transform": {
      "additionalProperties": false,
      "description": "A layer's placement, about the frame's centre.",
      "properties": {
        "position": {
          "$ref": "#/$defs/Animated",
          "default": [
            0.0,
            0.0
          ],
          "description": "Offset of the layer's centre from the frame's centre, as fractions of the frame (x right,\ny down)."
        },
        "rotation": {
          "$ref": "#/$defs/Animated2",
          "default": 0.0,
          "description": "Clockwise rotation in degrees."
        },
        "scale": {
          "$ref": "#/$defs/Animated2",
          "default": 1.0,
          "description": "Uniform scale; 1 is the fitted size."
        }
      },
      "type": "object"
    },
    "VideoCodec": {
      "description": "Video codecs.",
      "oneOf": [
        {
          "const": "h264",
          "description": "H.264 / AVC.",
          "type": "string"
        },
        {
          "const": "hevc",
          "description": "H.265 / HEVC.",
          "type": "string"
        },
        {
          "const": "av1",
          "description": "AV1.",
          "type": "string"
        }
      ]
    },
    "VideoEncoding": {
      "additionalProperties": false,
      "description": "Video encoding settings.",
      "properties": {
        "bitrate_kbps": {
          "description": "Target bitrate in kbit/s, when no `crf` is given.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "codec": {
          "$ref": "#/$defs/VideoCodec",
          "description": "Codec."
        },
        "crf": {
          "description": "Constant quality (lower is better), when the encoder supports it.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "codec"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A finished edit, ready to render.",
  "properties": {
    "assets": {
      "additionalProperties": {
        "$ref": "#/$defs/Asset"
      },
      "default": {},
      "description": "Every file the edit reads, by id. Ids are local to this spec.",
      "type": "object"
    },
    "audio": {
      "default": [],
      "description": "Sound, mixed together.",
      "items": {
        "$ref": "#/$defs/AudioClip"
      },
      "type": "array"
    },
    "engine": {
      "$ref": "#/$defs/EngineRequirements",
      "default": {},
      "description": "What the renderer must support."
    },
    "layers": {
      "default": [],
      "description": "Picture layers, bottom first.",
      "items": {
        "$ref": "#/$defs/Layer"
      },
      "type": "array"
    },
    "output": {
      "$ref": "#/$defs/Output",
      "description": "The picture and sound to produce."
    },
    "spec": {
      "description": "Format version; must be [`SPEC_VERSION`].",
      "type": "string"
    }
  },
  "required": [
    "spec",
    "output"
  ],
  "title": "RenderSpec",
  "type": "object"
}
