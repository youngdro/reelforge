{
  "$defs": {
    "Animated": {
      "anyOf": [
        {
          "description": "The same value throughout.",
          "format": "float",
          "type": "number"
        },
        {
          "description": "Keyframes, sorted by time; before the first and after the last the value holds.",
          "items": {
            "$ref": "#/$defs/Key"
          },
          "type": "array"
        }
      ],
      "description": "A value that is either constant or keyframed."
    },
    "Animated2": {
      "anyOf": [
        {
          "description": "The same value throughout.",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        {
          "description": "Keyframes, sorted by time; before the first and after the last the value holds.",
          "items": {
            "$ref": "#/$defs/Key2"
          },
          "type": "array"
        }
      ],
      "description": "A value that is either constant or keyframed."
    },
    "Asset": {
      "additionalProperties": false,
      "description": "A file the edit reads, addressed by content.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/AssetKind",
          "description": "What the file is."
        },
        "of": {
          "description": "For a derived asset (a mask sequence, a stabilisation track), the asset it was made from.",
          "type": [
            "string",
            "null"
          ]
        },
        "probe": {
          "anyOf": [
            {
              "$ref": "#/$defs/Probe"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the editor measured when it imported the file."
        },
        "sha256": {
          "description": "SHA-256 of the file's bytes, lowercase hex. This, not the URI, is the asset's identity.",
          "type": "string"
        },
        "uri": {
          "description": "Where to fetch it: `file:`, `https:`, `s3:`, `opfs:`… A renderer may resolve the hash\nthrough its own cache instead.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "sha256",
        "uri"
      ],
      "type": "object"
    },
    "AssetKind": {
      "description": "Asset kinds.",
      "oneOf": [
        {
          "const": "video",
          "description": "Video, possibly with sound.",
          "type": "string"
        },
        {
          "const": "image",
          "description": "A still image.",
          "type": "string"
        },
        {
          "const": "audio",
          "description": "Sound only.",
          "type": "string"
        },
        {
          "const": "font",
          "description": "A font file.",
          "type": "string"
        },
        {
          "const": "mask_sequence",
          "description": "Per-frame alpha masks derived from another asset.",
          "type": "string"
        },
        {
          "const": "lut",
          "description": "A colour lookup table.",
          "type": "string"
        }
      ]
    },
    "AudioClip": {
      "additionalProperties": false,
      "description": "Sound from an asset.",
      "properties": {
        "asset": {
          "description": "A `video` or `audio` asset. Empty when the clip plays a composition.",
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/Tick",
          "description": "When it starts on the output timeline."
        },
        "comp": {
          "description": "The composition whose mix it plays instead of an asset (feature `comp/1`), from\n`time.source_in` at speed 1.",
          "type": [
            "string",
            "null"
          ]
        },
        "dur": {
          "$ref": "#/$defs/Tick",
          "description": "How long it plays; positive."
        },
        "fx": {
          "description": "What is done to the sound, in order, before its gain (feature `audio.fx/1`).",
          "items": {
            "$ref": "#/$defs/AudioEffect"
          },
          "type": "array"
        },
        "gain_db": {
          "$ref": "#/$defs/Animated",
          "default": 0.0,
          "description": "Gain in dB; keyframe times are relative to the clip's start."
        },
        "id": {
          "description": "Id, unique among audio clips.",
          "type": "string"
        },
        "keep_pitch": {
          "description": "At a speed other than 1, stretch the sound in time keeping its pitch (feature\n`audio.stretch/1`) instead of resampling it, which moves the pitch with the speed.",
          "type": "boolean"
        },
        "pitch": {
          "description": "Semitones the sound is moved up (negative: down) without changing how long it lasts\n(feature `audio.pitch/1`). Sound played backwards ignores it.",
          "format": "float",
          "type": "number"
        },
        "time": {
          "$ref": "#/$defs/TimeMap",
          "default": {
            "source_in": 0,
            "speed": 1.0
          },
          "description": "Which source instant plays when."
        }
      },
      "required": [
        "id",
        "at",
        "dur"
      ],
      "type": "object"
    },
    "AudioCodec": {
      "description": "Audio codecs.",
      "oneOf": [
        {
          "const": "aac",
          "description": "AAC-LC.",
          "type": "string"
        },
        {
          "const": "opus",
          "description": "Opus.",
          "type": "string"
        }
      ]
    },
    "AudioEffect": {
      "description": "One thing done to a clip's sound. Each is a function of the clip's own samples, counted from\nits start (what came before the clip is silence), so a mix made in pieces matches one made\nwhole.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Steady background noise taken out. The sound is cut into frames of 1024 samples half a\nframe apart; in each, what does not rise above the noise is turned down.",
          "properties": {
            "amount": {
              "description": "How much is taken out, from 0 (nothing) to 1.",
              "format": "float",
              "type": "number"
            },
            "floor": {
              "description": "The noise: its power density in dB (full scale squared per hertz) in each of\n[`AudioEffect::NOISE_BANDS`] bands evenly spaced on a log scale from 60 Hz to 16 kHz,\nthe first and last taking what lies beyond.",
              "items": {
                "format": "float",
                "type": "number"
              },
              "type": "array"
            },
            "type": {
              "const": "denoise",
              "type": "string"
            }
          },
          "required": [
            "type",
            "floor",
            "amount"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Only what lies between two frequencies is kept, as through a telephone.",
          "properties": {
            "high": {
              "description": "The highest frequency kept, in Hz.",
              "format": "float",
              "type": "number"
            },
            "low": {
              "description": "The lowest frequency kept, in Hz.",
              "format": "float",
              "type": "number"
            },
            "type": {
              "const": "band",
              "type": "string"
            }
          },
          "required": [
            "type",
            "low",
            "high"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The sound multiplied by a sine wave (ring modulation): a robot's voice.",
          "properties": {
            "hz": {
              "description": "The sine's frequency in Hz.",
              "format": "float",
              "type": "number"
            },
            "mix": {
              "description": "How much of the result is the modulated sound, from 0 to 1.",
              "format": "float",
              "type": "number"
            },
            "type": {
              "const": "ring",
              "type": "string"
            }
          },
          "required": [
            "type",
            "hz",
            "mix"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The sound again, later and quieter, a number of times.",
          "properties": {
            "decay": {
              "description": "How loud each repeat is next to the one before, from 0 to 1.",
              "format": "float",
              "type": "number"
            },
            "delay": {
              "$ref": "#/$defs/Tick",
              "description": "The time between repeats."
            },
            "repeats": {
              "description": "How many repeats, from 1 to 8.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "echo",
              "type": "string"
            }
          },
          "required": [
            "type",
            "delay",
            "decay",
            "repeats"
          ],
          "type": "object"
        }
      ]
    },
    "AudioEncoding": {
      "additionalProperties": false,
      "description": "Audio encoding settings.",
      "properties": {
        "bitrate_kbps": {
          "description": "Bitrate in kbit/s.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "codec": {
          "$ref": "#/$defs/AudioCodec",
          "description": "Codec."
        },
        "sample_rate": {
          "description": "Sample rate in Hz.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "codec",
        "sample_rate",
        "bitrate_kbps"
      ],
      "type": "object"
    },
    "Between": {
      "description": "What a video layer shows at an instant between two of its file's frames.",
      "oneOf": [
        {
          "const": "nearest",
          "description": "The frame of that instant, held until the next.",
          "type": "string"
        },
        {
          "const": "blend",
          "description": "The two frames mixed, by how far along from the one to the other the instant is (feature\n`frames.blend/1`).",
          "type": "string"
        },
        {
          "const": "flow",
          "description": "A frame made in between (feature `frames.flow/1`): what moved from the one frame to the\nother is followed, and drawn as far along its way as the instant is. Where nothing can\nbe followed, the two are mixed as for `blend`.",
          "type": "string"
        }
      ]
    },
    "Blend": {
      "description": "Blend modes.",
      "oneOf": [
        {
          "const": "normal",
          "description": "Over.",
          "type": "string"
        },
        {
          "const": "add",
          "description": "Sum.",
          "type": "string"
        },
        {
          "const": "multiply",
          "description": "Product.",
          "type": "string"
        },
        {
          "const": "screen",
          "description": "Inverse product.",
          "type": "string"
        },
        {
          "const": "overlay",
          "description": "Multiply in the dark parts, screen in the bright (feature `blend/2`, as are those below).",
          "type": "string"
        },
        {
          "const": "darken",
          "description": "The darker of the two.",
          "type": "string"
        },
        {
          "const": "lighten",
          "description": "The lighter of the two.",
          "type": "string"
        },
        {
          "const": "soft_light",
          "description": "A gentle overlay.",
          "type": "string"
        },
        {
          "const": "hard_light",
          "description": "Overlay, led by the layer.",
          "type": "string"
        },
        {
          "const": "difference",
          "description": "The difference.",
          "type": "string"
        },
        {
          "const": "color_dodge",
          "description": "Brightens what is below.",
          "type": "string"
        },
        {
          "const": "color_burn",
          "description": "Darkens what is below.",
          "type": "string"
        }
      ]
    },
    "CharCurve": {
      "description": "How a character travels between `pose` and rest.",
      "oneOf": [
        {
          "const": "settle",
          "description": "From `pose` to rest once, fast at first and slowing into place; its opacity in a straight line.",
          "type": "string"
        },
        {
          "const": "spring",
          "description": "As `settle`, overshooting rest a little before it comes back.",
          "type": "string"
        },
        {
          "const": "wave",
          "description": "To `pose`, back through rest to its opposite and back, every round.",
          "type": "string"
        },
        {
          "const": "hop",
          "description": "To `pose` and back in the first half of every round, at rest in the second.",
          "type": "string"
        }
      ]
    },
    "CharMotion": {
      "additionalProperties": false,
      "description": "One way a text's characters move one after another (`text/5`). Characters are counted from\nthe start of the text, white space left out.",
      "properties": {
        "curve": {
          "$ref": "#/$defs/CharCurve",
          "description": "How a character travels."
        },
        "pose": {
          "$ref": "#/$defs/CharPose",
          "description": "Where a character is when it is furthest from rest."
        },
        "progress": {
          "$ref": "#/$defs/Animated",
          "description": "How far along the movement is. For `settle` and `spring`: 0, no character has started, to\n1, every character is in place. For `wave` and `hop`: rounds, 1 a whole round."
        },
        "reverse": {
          "description": "Counted from the last character instead of the first.",
          "type": "boolean"
        },
        "step": {
          "description": "How much later each character starts than the one before. For `settle` and `spring`, in\nunits of one character's own time: 0 moves them all together, 1 starts each as the one\nbefore arrives. For `wave` and `hop`, in rounds.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "progress",
        "step",
        "curve",
        "pose"
      ],
      "type": "object"
    },
    "CharPose": {
      "additionalProperties": false,
      "description": "Where a character is, against where the layout puts it.",
      "properties": {
        "offset": {
          "default": [
            0.0,
            0.0
          ],
          "description": "Moved `[right, down]`, in ems.",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "opacity": {
          "default": 1.0,
          "description": "How much of it shows, 0 to 1.",
          "format": "float",
          "type": "number"
        },
        "rotation": {
          "default": 0.0,
          "description": "Turned about its own centre, degrees clockwise.",
          "format": "float",
          "type": "number"
        },
        "scale": {
          "default": 1.0,
          "description": "Scaled about its own centre.",
          "format": "float",
          "type": "number"
        }
      },
      "type": "object"
    },
    "Color": {
      "description": "A straight (not premultiplied) sRGB colour with alpha, each 0 to 1.",
      "items": {
        "format": "float",
        "type": "number"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "Comp": {
      "additionalProperties": false,
      "description": "A composition: an edit inside the edit (a compound clip's timeline). Its picture is as large\nas the output and see-through where no layer draws; its time starts at 0.",
      "properties": {
        "audio": {
          "default": [],
          "description": "Sound, mixed together.",
          "items": {
            "$ref": "#/$defs/AudioClip"
          },
          "type": "array"
        },
        "layers": {
          "default": [],
          "description": "Picture layers, bottom first.",
          "items": {
            "$ref": "#/$defs/Layer"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Crop": {
      "additionalProperties": false,
      "description": "Edges cut off a picture, as fractions of its width (`left`, `right`) and height (`top`,\n`bottom`); what is left must be at least 1 % of each.",
      "properties": {
        "bottom": {
          "default": 0.0,
          "description": "From the bottom edge.",
          "format": "float",
          "type": "number"
        },
        "left": {
          "default": 0.0,
          "description": "From the left edge.",
          "format": "float",
          "type": "number"
        },
        "right": {
          "default": 0.0,
          "description": "From the right edge.",
          "format": "float",
          "type": "number"
        },
        "top": {
          "default": 0.0,
          "description": "From the top edge.",
          "format": "float",
          "type": "number"
        }
      },
      "type": "object"
    },
    "CropKeys": {
      "additionalProperties": false,
      "description": "A crop that changes: each edge as in [`Crop`], keyed. A renderer keeps at least 1 % of the\npicture, shrinking a pair of opposite edges in proportion where their keys would cut more.",
      "properties": {
        "bottom": {
          "$ref": "#/$defs/Animated",
          "default": 0.0,
          "description": "From the bottom edge."
        },
        "left": {
          "$ref": "#/$defs/Animated",
          "default": 0.0,
          "description": "From the left edge."
        },
        "right": {
          "$ref": "#/$defs/Animated",
          "default": 0.0,
          "description": "From the right edge."
        },
        "top": {
          "$ref": "#/$defs/Animated",
          "default": 0.0,
          "description": "From the top edge."
        }
      },
      "type": "object"
    },
    "Ease": {
      "description": "Interpolation from one key to the next.",
      "oneOf": [
        {
          "const": "linear",
          "description": "Straight line.",
          "type": "string"
        },
        {
          "const": "hold",
          "description": "Hold this value until the next key.",
          "type": "string"
        },
        {
          "const": "in_out",
          "description": "Smoothstep: slow out of this key and into the next.",
          "type": "string"
        }
      ]
    },
    "Effect": {
      "additionalProperties": false,
      "description": "An effect applied to a layer.",
      "properties": {
        "asset": {
          "description": "An asset the effect reads: the `lut` of `color.lut@1`.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "`<name>@<version>`, such as `color.brightness@1`.",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/Animated"
          },
          "default": {},
          "description": "Parameters by name.",
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "EngineRequirements": {
      "additionalProperties": false,
      "description": "What a renderer must provide to draw this spec.",
      "properties": {
        "features": {
          "description": "Feature ids the spec uses beyond the base format, such as `text/1`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "min": {
          "description": "The oldest renderer version that draws this spec correctly (semver), if any.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Fit": {
      "description": "How media is fitted to the output frame.",
      "oneOf": [
        {
          "const": "contain",
          "description": "Whole picture visible, bars where the shapes differ.",
          "type": "string"
        },
        {
          "const": "cover",
          "description": "Frame covered, picture cropped where the shapes differ.",
          "type": "string"
        },
        {
          "const": "stretch",
          "description": "Stretched to the frame.",
          "type": "string"
        }
      ]
    },
    "FrameRate": {
      "description": "A rational frame rate, `num / den` frames per second (30000 / 1001 is 29.97).",
      "properties": {
        "den": {
          "description": "Denominator; never zero.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "num": {
          "description": "Numerator.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "num",
        "den"
      ],
      "type": "object"
    },
    "Key": {
      "additionalProperties": false,
      "description": "One keyframe.",
      "properties": {
        "ease": {
          "$ref": "#/$defs/Ease",
          "default": "linear",
          "description": "How the value moves from this key to the next."
        },
        "t": {
          "$ref": "#/$defs/Tick",
          "description": "Time relative to the owner's start."
        },
        "v": {
          "description": "Value at that time.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "t",
        "v"
      ],
      "type": "object"
    },
    "Key2": {
      "additionalProperties": false,
      "description": "One keyframe.",
      "properties": {
        "ease": {
          "$ref": "#/$defs/Ease",
          "default": "linear",
          "description": "How the value moves from this key to the next."
        },
        "t": {
          "$ref": "#/$defs/Tick",
          "description": "Time relative to the owner's start."
        },
        "v": {
          "description": "Value at that time.",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "t",
        "v"
      ],
      "type": "object"
    },
    "Layer": {
      "additionalProperties": false,
      "description": "One picture layer.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Tick",
          "description": "When the layer starts on the output timeline."
        },
        "blend": {
          "$ref": "#/$defs/Blend",
          "default": "normal",
          "description": "How it combines with what is below."
        },
        "content": {
          "$ref": "#/$defs/LayerContent",
          "description": "What it shows."
        },
        "crop": {
          "anyOf": [
            {
              "$ref": "#/$defs/Crop"
            },
            {
              "type": "null"
            }
          ],
          "description": "Edges cut off a media layer's picture before it is fitted (feature `crop/1`)."
        },
        "crop_keys": {
          "anyOf": [
            {
              "$ref": "#/$defs/CropKeys"
            },
            {
              "type": "null"
            }
          ],
          "description": "The crop over the layer's time, in place of `crop` (feature `crop/2`)."
        },
        "dur": {
          "$ref": "#/$defs/Tick",
          "description": "How long it lasts; positive."
        },
        "flip_x": {
          "description": "A media layer's picture mirrored left to right (feature `flip/1`).",
          "type": "boolean"
        },
        "flip_y": {
          "description": "A media layer's picture mirrored top to bottom (feature `flip/1`).",
          "type": "boolean"
        },
        "fx": {
          "description": "Effects, applied in order to the layer's own picture before it is placed.",
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "type": "array"
        },
        "id": {
          "description": "Id, unique in the spec; the editor uses its clip id so a render maps back to the edit.",
          "type": "string"
        },
        "mask": {
          "description": "A `mask_sequence` asset whose alpha multiplies this layer.",
          "type": [
            "string",
            "null"
          ]
        },
        "opacity": {
          "$ref": "#/$defs/Animated",
          "default": 1.0,
          "description": "Opacity, 0 to 1."
        },
        "shape_mask": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShapeMask"
            },
            {
              "type": "null"
            }
          ],
          "description": "A shape that shows part of the layer, in the layer's own picture (feature `mask.shape/1`)."
        },
        "shape_mask_keys": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShapeMaskKeys"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where and how big `shape_mask` is over the layer's time, in place of its own centre, size,\nrotation and feather (feature `mask.shape/2`)."
        },
        "transform": {
          "$ref": "#/$defs/Transform",
          "default": {
            "position": [
              0.0,
              0.0
            ],
            "rotation": 0.0,
            "scale": 1.0
          },
          "description": "Where it sits. Keyframe times are relative to the layer's start."
        }
      },
      "required": [
        "id",
        "at",
        "dur",
        "content"
      ],
      "type": "object"
    },
    "LayerContent": {
      "description": "What a layer shows.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Frames of a video or image asset.",
          "properties": {
            "asset": {
              "description": "The asset id.",
              "type": "string"
            },
            "between": {
              "$ref": "#/$defs/Between",
              "description": "What shows when an output instant falls between two frames of a video: what a clip\nslowed down, or a file of fewer frames a second than the output, is made smooth with.\nA still ignores it."
            },
            "fit": {
              "$ref": "#/$defs/Fit",
              "default": "contain",
              "description": "How the picture is fitted to the frame before the transform applies."
            },
            "time": {
              "$ref": "#/$defs/TimeMap",
              "default": {
                "source_in": 0,
                "speed": 1.0
              },
              "description": "Which source instant each output instant shows."
            },
            "type": {
              "const": "media",
              "type": "string"
            }
          },
          "required": [
            "type",
            "asset"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A flat colour filling the frame.",
          "properties": {
            "color": {
              "$ref": "#/$defs/Color",
              "description": "The colour."
            },
            "type": {
              "const": "solid",
              "type": "string"
            }
          },
          "required": [
            "type",
            "color"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Set text (feature `text/1`).",
          "properties": {
            "align": {
              "$ref": "#/$defs/TextAlign",
              "default": "center",
              "description": "Alignment of the lines within the block."
            },
            "background": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TextBackground"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A box behind the block."
            },
            "chars": {
              "description": "With `text/5`: the characters move one after another, each about its own centre, from where\nthe layout puts them. Several movements add up. Boxes and underlines stay where they are.",
              "items": {
                "$ref": "#/$defs/CharMotion"
              },
              "type": "array"
            },
            "color": {
              "$ref": "#/$defs/Color",
              "description": "Fill colour."
            },
            "font": {
              "description": "A `font` asset; absent means the renderer's bundled default face (Noto Sans SC, which also\ncovers Latin). Characters the face lacks fall back to the other faces the renderer has.",
              "type": [
                "string",
                "null"
              ]
            },
            "gradient": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Color"
                },
                {
                  "type": "null"
                }
              ],
              "description": "With `text/2`: the fill fades from `color` at the block's top to this at its bottom."
            },
            "italic": {
              "description": "With `text/4`: slanted; the face's own italic when it has one, otherwise sheared.",
              "type": "boolean"
            },
            "leading": {
              "description": "With `text/4`: space added between lines, in ems (negative: closer together).",
              "format": "float",
              "type": "number"
            },
            "outer": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TextStroke"
                },
                {
                  "type": "null"
                }
              ],
              "description": "With `text/2`: a second outline, outside `stroke` (its width counts from `stroke`'s edge)."
            },
            "reveal": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Animated"
                },
                {
                  "type": "null"
                }
              ],
              "description": "With `text/3`: how much of the text shows, 0 to 1, counted in characters from the start\n(a typewriter). The lines stay where the whole text puts them; a box behind each line\ngrows with what shows of it."
            },
            "shadow": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TextShadow"
                },
                {
                  "type": "null"
                }
              ],
              "description": "With `text/2`: a soft shadow of the glyphs and their outlines, beneath them."
            },
            "size": {
              "description": "Size of the em in output pixels.",
              "format": "float",
              "type": "number"
            },
            "stroke": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TextStroke"
                },
                {
                  "type": "null"
                }
              ],
              "description": "An outline around the glyphs, drawn beneath the fill."
            },
            "text": {
              "description": "The words; `\\n` breaks a line.",
              "type": "string"
            },
            "tracking": {
              "description": "With `text/4`: space added after every character, in ems (negative: closer together).",
              "format": "float",
              "type": "number"
            },
            "type": {
              "const": "text",
              "type": "string"
            },
            "underline": {
              "description": "With `text/4`: a line under each line of text, outlined and shadowed with the glyphs.",
              "type": "boolean"
            },
            "weight": {
              "default": 400,
              "description": "Weight, 100 (thin) to 900 (black); 400 is regular, 700 bold.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "width": {
              "description": "Wrap width in output pixels; absent, lines break only at `\\n`.",
              "format": "float",
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "text",
            "size",
            "color"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The picture of a composition (feature `comp/1`): drawn first, on a see-through frame the\nsize of the output, then placed, cropped, masked and given this layer's effects as one\npicture.",
          "properties": {
            "comp": {
              "description": "The composition's id in [`RenderSpec::comps`].",
              "type": "string"
            },
            "from": {
              "$ref": "#/$defs/Tick",
              "default": 0,
              "description": "The composition's instant shown at the layer's start; it runs at speed 1 from there."
            },
            "type": {
              "const": "comp",
              "type": "string"
            }
          },
          "required": [
            "type",
            "comp"
          ],
          "type": "object"
        }
      ]
    },
    "MaskShape": {
      "description": "Mask shapes.",
      "oneOf": [
        {
          "const": "linear",
          "description": "Everything above a line through the centre (turned by `rotation`).",
          "type": "string"
        },
        {
          "const": "mirror",
          "description": "A band through the centre.",
          "type": "string"
        },
        {
          "const": "circle",
          "description": "An ellipse.",
          "type": "string"
        },
        {
          "const": "rectangle",
          "description": "A rectangle.",
          "type": "string"
        }
      ]
    },
    "Output": {
      "additionalProperties": false,
      "description": "Output settings.",
      "properties": {
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioEncoding"
            },
            {
              "type": "null"
            }
          ],
          "description": "How to encode the sound; absent for a silent output."
        },
        "background": {
          "$ref": "#/$defs/Color",
          "default": [
            0.0,
            0.0,
            0.0,
            1.0
          ],
          "description": "Colour under every layer (straight sRGB, 0 to 1)."
        },
        "duration": {
          "$ref": "#/$defs/Tick",
          "description": "Length of the output."
        },
        "format": {
          "$ref": "#/$defs/OutputFormat",
          "description": "The kind of file to write."
        },
        "fps": {
          "$ref": "#/$defs/FrameRate",
          "description": "Frame rate."
        },
        "height": {
          "description": "Height in pixels; even, at most 8192.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "video": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoEncoding"
            },
            {
              "type": "null"
            }
          ],
          "description": "How to encode the picture; absent when only frames are wanted."
        },
        "width": {
          "description": "Width in pixels; even, at most 8192.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "fps",
        "duration"
      ],
      "type": "object"
    },
    "OutputFormat": {
      "description": "The kind of file an output is written as.",
      "oneOf": [
        {
          "const": "mp4",
          "description": "The picture and the sound, in an MP4.",
          "type": "string"
        },
        {
          "const": "gif",
          "description": "The picture alone as an animated GIF that plays round and round (feature `encode.gif/1`),\nat `video.size` when one is given; a frame lasts `1 ÷ fps`, to the hundredth of a second.",
          "type": "string"
        },
        {
          "const": "m4a",
          "description": "The sound alone, encoded as `audio` says, in an M4A (feature `encode.audio/1`).",
          "type": "string"
        },
        {
          "const": "wav",
          "description": "The sound alone as 16-bit PCM in a WAV, at `audio`'s sample rate (feature\n`encode.audio/1`).",
          "type": "string"
        }
      ]
    },
    "Probe": {
      "additionalProperties": false,
      "description": "Measured properties of an asset.",
      "properties": {
        "duration": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tick"
            },
            {
              "type": "null"
            }
          ],
          "description": "Length, for time-based media."
        },
        "height": {
          "description": "Picture height in pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "width": {
          "description": "Picture width in pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ShapeMask": {
      "additionalProperties": false,
      "description": "A shape that shows part of a layer.\n\nIt is placed in the layer's own picture (after any crop), so it moves, turns and scales with\nthe layer. Lengths are in units of the picture's shorter side, so a circle stays round.",
      "properties": {
        "center": {
          "default": [
            0.5,
            0.5
          ],
          "description": "Its centre, as fractions of the picture's width and height (0.5, 0.5 is the middle).",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "feather": {
          "default": 0.0,
          "description": "Width of the soft edge, 0 for a hard one.",
          "format": "float",
          "type": "number"
        },
        "invert": {
          "description": "Show the outside instead.",
          "type": "boolean"
        },
        "rotation": {
          "default": 0.0,
          "description": "Clockwise turn, degrees.",
          "format": "float",
          "type": "number"
        },
        "shape": {
          "$ref": "#/$defs/MaskShape",
          "description": "Which shape."
        },
        "size": {
          "default": [
            0.5,
            0.5
          ],
          "description": "Width and height (for `mirror`, the height is the band's thickness; `linear` ignores it).",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "shape"
      ],
      "type": "object"
    },
    "ShapeMaskKeys": {
      "additionalProperties": false,
      "description": "A shape mask that moves: the values of [`ShapeMask`] that can, keyed.",
      "properties": {
        "center": {
          "$ref": "#/$defs/Animated2",
          "description": "The centre."
        },
        "feather": {
          "$ref": "#/$defs/Animated",
          "description": "Width of the soft edge."
        },
        "rotation": {
          "$ref": "#/$defs/Animated",
          "description": "Clockwise turn, degrees."
        },
        "size": {
          "$ref": "#/$defs/Animated2",
          "description": "Width and height."
        }
      },
      "required": [
        "center",
        "size",
        "rotation",
        "feather"
      ],
      "type": "object"
    },
    "SpeedKey": {
      "additionalProperties": false,
      "description": "One point of a speed ramp.",
      "properties": {
        "speed": {
          "description": "Speed there, -100 to 100.",
          "format": "double",
          "type": "number"
        },
        "t": {
          "$ref": "#/$defs/Tick",
          "description": "Time from the owner's start."
        }
      },
      "required": [
        "t",
        "speed"
      ],
      "type": "object"
    },
    "TextAlign": {
      "description": "How lines line up within a text block.",
      "oneOf": [
        {
          "const": "left",
          "description": "Left edges line up.",
          "type": "string"
        },
        {
          "const": "center",
          "description": "Centred.",
          "type": "string"
        },
        {
          "const": "right",
          "description": "Right edges line up.",
          "type": "string"
        }
      ]
    },
    "TextBackground": {
      "additionalProperties": false,
      "description": "A box behind text.",
      "properties": {
        "color": {
          "$ref": "#/$defs/Color",
          "description": "Colour."
        },
        "lines": {
          "description": "With `text/3`: a box behind each line, hugging it, instead of one behind the block.",
          "type": "boolean"
        },
        "padding": {
          "default": 0.25,
          "description": "Space between the text and the box edge, in ems.",
          "format": "float",
          "type": "number"
        },
        "radius": {
          "description": "With `text/2`: corner radius, in ems.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "color"
      ],
      "type": "object"
    },
    "TextShadow": {
      "additionalProperties": false,
      "description": "A shadow beneath text.",
      "properties": {
        "blur": {
          "default": 0.0,
          "description": "Softness: the blur's standard deviation, in ems.",
          "format": "float",
          "type": "number"
        },
        "color": {
          "$ref": "#/$defs/Color",
          "description": "Colour."
        },
        "offset": {
          "description": "Offset `[right, down]` in ems, on the frame (it does not turn with the text).",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "color",
        "offset"
      ],
      "type": "object"
    },
    "TextStroke": {
      "additionalProperties": false,
      "description": "An outline around text.",
      "properties": {
        "color": {
          "$ref": "#/$defs/Color",
          "description": "Colour."
        },
        "width": {
          "description": "Width outside the glyph edge, in output pixels.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "color",
        "width"
      ],
      "type": "object"
    },
    "Tick": {
      "description": "A position or a duration in ticks.",
      "format": "int64",
      "type": "integer"
    },
    "TimeMap": {
      "additionalProperties": false,
      "description": "Source time for a media layer or audio clip: `source = source_in + ∫ speed dt` from the owner's\nstart. With no `ramp` the speed is constant, so `source = source_in + (t - at) * speed`.",
      "properties": {
        "ramp": {
          "description": "A speed that changes over time (feature `time.ramp/1`): straight lines between keys, held\nbefore the first and after the last. Key times are from the owner's start.",
          "items": {
            "$ref": "#/$defs/SpeedKey"
          },
          "type": "array"
        },
        "source_in": {
          "$ref": "#/$defs/Tick",
          "default": 0,
          "description": "Source instant shown at the owner's start."
        },
        "speed": {
          "default": 1.0,
          "description": "Playback speed, -100 to 100. 0 holds `source_in` (a freeze frame, feature `time.hold/1`);\nbelow 0 plays backwards (feature `time.reverse/1`). Ignored when `ramp` is given.",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "Transform": {
      "additionalProperties": false,
      "description": "A layer's placement, about the frame's centre.",
      "properties": {
        "position": {
          "$ref": "#/$defs/Animated2",
          "default": [
            0.0,
            0.0
          ],
          "description": "Offset of the layer's centre from the frame's centre, as fractions of the frame (x right,\ny down)."
        },
        "rotation": {
          "$ref": "#/$defs/Animated",
          "default": 0.0,
          "description": "Clockwise rotation in degrees."
        },
        "scale": {
          "$ref": "#/$defs/Animated",
          "default": 1.0,
          "description": "Uniform scale; 1 is the fitted size."
        }
      },
      "type": "object"
    },
    "VideoCodec": {
      "description": "Video codecs.",
      "oneOf": [
        {
          "const": "h264",
          "description": "H.264 / AVC.",
          "type": "string"
        },
        {
          "const": "hevc",
          "description": "H.265 / HEVC.",
          "type": "string"
        },
        {
          "const": "av1",
          "description": "AV1.",
          "type": "string"
        }
      ]
    },
    "VideoEncoding": {
      "additionalProperties": false,
      "description": "Video encoding settings.",
      "properties": {
        "bitrate_kbps": {
          "description": "Target bitrate in kbit/s: used when no `crf` is given, or by encoders without a\nconstant-quality mode (hardware ones).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "codec": {
          "$ref": "#/$defs/VideoCodec",
          "description": "Codec."
        },
        "crf": {
          "description": "Constant quality (lower is better), when the encoder supports it.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "size": {
          "description": "Encode at this size instead of the output's (feature `encode.size/1`): the frame is drawn\n`width ÷ output.width` times the output size. Both even, and the height must be\n`round(output.height × width ÷ output.width)`, so the picture is not stretched.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "codec"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A finished edit, ready to render.",
  "properties": {
    "assets": {
      "additionalProperties": {
        "$ref": "#/$defs/Asset"
      },
      "default": {},
      "description": "Every file the edit reads, by id. Ids are local to this spec.",
      "type": "object"
    },
    "audio": {
      "default": [],
      "description": "Sound, mixed together.",
      "items": {
        "$ref": "#/$defs/AudioClip"
      },
      "type": "array"
    },
    "comps": {
      "additionalProperties": {
        "$ref": "#/$defs/Comp"
      },
      "description": "Compositions by id (feature `comp/1`): each a picture and a sound made of layers and\naudio clips of its own, shown by [`LayerContent::Comp`] layers and played by audio clips\nthat name it. Ids are local to this spec.",
      "type": "object"
    },
    "engine": {
      "$ref": "#/$defs/EngineRequirements",
      "default": {},
      "description": "What the renderer must support."
    },
    "layers": {
      "default": [],
      "description": "Picture layers, bottom first.",
      "items": {
        "$ref": "#/$defs/Layer"
      },
      "type": "array"
    },
    "output": {
      "$ref": "#/$defs/Output",
      "description": "The picture and sound to produce."
    },
    "spec": {
      "description": "Format version; must be [`SPEC_VERSION`].",
      "type": "string"
    }
  },
  "required": [
    "spec",
    "output"
  ],
  "title": "RenderSpec",
  "type": "object"
}
